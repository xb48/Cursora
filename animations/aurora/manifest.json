{
  "id": "aurora",
  "name": "Aurora",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A ribbon of northern light. The spectrum flows continuously from handle to tip, and cracks scatter a prismatic burst.",
  "category": "Neon",
  "tags": [
    "rainbow",
    "gradient",
    "calm",
    "prismatic"
  ],
  "entry": "overlay.html",
  "cursor": "replace",
  "thumbnail": "thumbnail.svg",
  "accent": "#7c8cff",
  "settings": [
    {
      "key": "segments",
      "label": "Length (links)",
      "type": "range",
      "group": "Physics",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 32
    },
    {
      "key": "segmentLength",
      "label": "Link length",
      "type": "range",
      "group": "Physics",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "key": "gravity",
      "label": "Gravity",
      "type": "range",
      "group": "Physics",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1.2
    },
    {
      "key": "damping",
      "label": "Air drag",
      "type": "range",
      "group": "Physics",
      "min": 0.85,
      "max": 0.995,
      "step": 0.005,
      "default": 0.96,
      "hint": "Higher keeps momentum longer"
    },
    {
      "key": "crackSpeed",
      "label": "Crack threshold",
      "type": "range",
      "group": "Crack",
      "min": 120,
      "max": 700,
      "step": 10,
      "default": 340,
      "hint": "Lower cracks more easily"
    },
    {
      "key": "volume",
      "label": "Crack volume",
      "type": "range",
      "group": "Crack",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "hue",
      "label": "Starting hue",
      "type": "range",
      "group": "Look",
      "min": 0,
      "max": 359,
      "step": 1,
      "default": 150,
      "unit": "°"
    },
    {
      "key": "spread",
      "label": "Spectrum width",
      "type": "range",
      "group": "Look",
      "min": 20,
      "max": 360,
      "step": 5,
      "default": 220,
      "unit": "°"
    },
    {
      "key": "flow",
      "label": "Color flow speed",
      "type": "range",
      "group": "Look",
      "min": 0,
      "max": 4,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "glow",
      "label": "Glow",
      "type": "range",
      "group": "Look",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.7,
      "unit": "%"
    },
    {
      "key": "lineWidthHandle",
      "label": "Handle thickness",
      "type": "range",
      "group": "Look",
      "min": 2,
      "max": 16,
      "step": 0.5,
      "default": 7,
      "unit": "px"
    },
    {
      "key": "lineWidthTip",
      "label": "Tip thickness",
      "type": "range",
      "group": "Look",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "default": 3,
      "unit": "px"
    },
    {
      "key": "particles",
      "label": "Crack effects",
      "type": "toggle",
      "group": "Look",
      "default": true,
      "hint": "Sparks and shockwaves on every crack"
    }
  ]
}
