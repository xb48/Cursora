{
  "id": "bees",
  "name": "Swarm",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A dozen honeybees orbiting a honeycomb cell at your cursor. Fast movement makes them angry: they speed up and glow red until the whole swarm dives in to sting.",
  "category": "Animals",
  "tags": [
    "bees",
    "swarm",
    "insects",
    "anger"
  ],
  "entry": "overlay.html",
  "cursor": "follow",
  "thumbnail": "thumbnail.png",
  "accent": "#ffc83d",
  "hints": [
    "Move fast to anger them",
    "They sting when furious",
    "Hotkey toggles it on and off"
  ],
  "settings": [
    {
      "key": "size",
      "label": "Size",
      "type": "range",
      "group": "Motion",
      "min": 0.6,
      "max": 1.8,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "temper",
      "label": "Temper",
      "type": "range",
      "group": "Trigger",
      "min": 0.3,
      "max": 3,
      "step": 0.05,
      "default": 1,
      "hint": "How quickly they get angry"
    },
    {
      "key": "volume",
      "label": "Volume",
      "type": "range",
      "group": "Trigger",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "color",
      "label": "Bee color",
      "type": "color",
      "group": "Look",
      "default": "#ffc83d"
    },
    {
      "key": "hive",
      "label": "Honeycomb cursor",
      "type": "toggle",
      "group": "Look",
      "default": true
    },
    {
      "key": "particles",
      "label": "Trigger effects",
      "type": "toggle",
      "group": "Look",
      "default": true,
      "hint": "Shockwaves and particles when it fires"
    }
  ]
}
