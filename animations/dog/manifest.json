      "default": 1,
      "unit": "%"
    },
    {
      "key": "agility",
      "label": "Agility",
      "type": "range",
      "group": "Motion",
      "min": 0.4,
      "max": 2,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "throwSpeed",
      "label": "Throw speed",
      "type": "range",
      "group": "Trigger",
      "min": 12,
      "max": 60,
      "step": 1,
      "default": 26,
      "unit": "px",
      "hint": "Flick speed that throws the ball"
    },
    {
      "key": "volume",
      "label": "Volume",
      "type": "range",
      "group": "Trigger",
      "min": 0,
