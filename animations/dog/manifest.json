{
  "id": "dog",
  "name": "Biscuit",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A corgi who plays fetch. Your cursor holds a tennis ball: flick to throw it. Biscuit runs it down, carries it back, drops it at your cursor and barks.",
  "category": "Animals",
  "tags": [
    "dog",
    "corgi",
    "fetch",
    "pet"
  ],
  "entry": "overlay.html",
  "cursor": "follow",
  "thumbnail": "thumbnail.png",
  "accent": "#e8913a",
  "hints": [
    "Flick to throw the ball",
    "It barks when it brings it back",
    "Hotkey toggles it on and off"
  ],
  "settings": [
