{
  "id": "liquid",
  "name": "Liquid",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A glossy soft-body gel that rides your cursor. It wobbles with every move, and if you shake it hard enough it splats.",
  "category": "Fluid",
  "tags": [
    "gel",
    "soft body",
    "jelly",
    "glossy"
  ],
  "entry": "overlay.html",
  "cursor": "replace",
  "thumbnail": "thumbnail.svg",
  "accent": "#7c5cff",
  "hints": [
    "Move to wobble",
    "Shake hard to splat",
    "Hotkey toggles it on and off"
  ],
  "settings": [
    {
      "key": "size",
      "label": "Size",
      "type": "range",
      "group": "Motion",
      "min": 0.6,
      "max": 1.8,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "firmness",
      "label": "Firmness",
      "type": "range",
      "group": "Motion",
      "min": 0.04,
      "max": 0.3,
      "step": 0.005,
      "default": 0.12,
      "hint": "Lower is wobblier"
    },
    {
      "key": "splat",
      "label": "Splat threshold",
      "type": "range",
      "group": "Trigger",
      "min": 0.12,
      "max": 0.7,
      "step": 0.01,
      "default": 0.3,
      "hint": "How far it must deform to splat"
    },
    {
      "key": "volume",
      "label": "Volume",
      "type": "range",
      "group": "Trigger",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "color",
      "label": "Gel color",
      "type": "color",
      "group": "Look",
      "default": "#7c5cff"
    },
    {
      "key": "shine",
      "label": "Highlight",
      "type": "color",
      "group": "Look",
      "default": "#d9ceff"
    },
    {
      "key": "particles",
      "label": "Trigger effects",
      "type": "toggle",
      "group": "Look",
      "default": true,
      "hint": "Shockwaves and particles when it fires"
    }
  ]
}
