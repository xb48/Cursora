{
  "id": "neon",
  "name": "Neon Lash",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A glowing gas-tube lash with a white-hot core. Cyan to magenta by default, every color is yours to tune, and each crack fires a double shockwave of sparks.",
  "category": "Neon",
  "tags": [
    "neon",
    "glow",
    "cyberpunk",
    "sparks"
  ],
  "entry": "overlay.html",
  "cursor": "replace",
  "thumbnail": "thumbnail.svg",
  "accent": "#00e5ff",
  "settings": [
    {
      "key": "segments",
      "label": "Length (links)",
      "type": "range",
      "group": "Physics",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 28
    },
    {
      "key": "segmentLength",
      "label": "Link length",
      "type": "range",
      "group": "Physics",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 25,
      "unit": "px"
    },
    {
      "key": "gravity",
      "label": "Gravity",
      "type": "range",
      "group": "Physics",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1.2
    },
    {
      "key": "damping",
      "label": "Air drag",
      "type": "range",
      "group": "Physics",
      "min": 0.85,
      "max": 0.995,
      "step": 0.005,
      "default": 0.96,
      "hint": "Higher keeps momentum longer"
    },
    {
      "key": "crackSpeed",
      "label": "Crack threshold",
      "type": "range",
      "group": "Crack",
      "min": 120,
      "max": 700,
      "step": 10,
      "default": 340,
      "hint": "Lower cracks more easily"
    },
    {
      "key": "volume",
      "label": "Crack volume",
      "type": "range",
      "group": "Crack",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "colorA",
      "label": "Handle color",
      "type": "color",
      "group": "Look",
      "default": "#00e5ff"
    },
    {
      "key": "colorB",
      "label": "Tip color",
      "type": "color",
      "group": "Look",
      "default": "#ff2bd6"
    },
    {
      "key": "glow",
      "label": "Glow",
      "type": "range",
      "group": "Look",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "unit": "%"
    },
    {
      "key": "lineWidthHandle",
      "label": "Handle thickness",
      "type": "range",
      "group": "Look",
      "min": 2,
      "max": 16,
      "step": 0.5,
      "default": 6,
      "unit": "px"
    },
    {
      "key": "lineWidthTip",
      "label": "Tip thickness",
      "type": "range",
      "group": "Look",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "default": 3.5,
      "unit": "px"
    },
    {
      "key": "particles",
      "label": "Crack effects",
      "type": "toggle",
      "group": "Look",
      "default": true,
      "hint": "Sparks and shockwaves on every crack"
    }
  ]
}
