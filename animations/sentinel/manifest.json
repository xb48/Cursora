{
  "id": "sentinel",
  "name": "Sentinel",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A hover drone that escorts your cursor and keeps its eye on it. Flick sharply and it fires a laser at the reticle.",
  "category": "Tech",
  "tags": [
    "drone",
    "laser",
    "companion",
    "sci-fi"
  ],
  "entry": "overlay.html",
  "cursor": "follow",
  "thumbnail": "thumbnail.svg",
  "accent": "#29e0ff",
  "hints": [
    "Move to guide",
    "Flick to fire",
    "Hotkey toggles it on and off"
  ],
  "settings": [
    {
      "key": "size",
      "label": "Size",
      "type": "range",
      "group": "Motion",
      "min": 0.6,
      "max": 1.8,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "follow",
      "label": "Follow speed",
      "type": "range",
      "group": "Motion",
      "min": 0.03,
      "max": 0.2,
      "step": 0.005,
      "default": 0.08
    },
    {
      "key": "zap",
      "label": "Fire threshold",
      "type": "range",
      "group": "Trigger",
      "min": 15,
      "max": 90,
      "step": 1,
      "default": 38,
      "unit": "px",
      "hint": "Flick speed needed to fire"
    },
    {
      "key": "volume",
      "label": "Volume",
      "type": "range",
      "group": "Trigger",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "eye",
      "label": "Eye + laser",
      "type": "color",
      "group": "Look",
      "default": "#29e0ff"
    },
    {
      "key": "shell",
      "label": "Shell",
      "type": "color",
      "group": "Look",
      "default": "#2c313c"
    },
    {
      "key": "reticle",
      "label": "Cursor reticle",
      "type": "toggle",
      "group": "Look",
      "default": true
    },
    {
      "key": "particles",
      "label": "Trigger effects",
      "type": "toggle",
      "group": "Look",
      "default": true,
      "hint": "Shockwaves and particles when it fires"
    }
  ]
}
