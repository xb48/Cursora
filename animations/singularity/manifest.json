{
  "id": "singularity",
  "name": "Singularity",
  "version": "1.0.0",
  "author": "Cursora",
  "description": "A pocket black hole with a gravitationally lensed accretion disk. Circle your cursor around it to feed it, and when the orbits are complete it collapses in a burst of light and gravitational waves.",
  "category": "Cosmic",
  "tags": [
    "black hole",
    "space",
    "gesture",
    "orbit"
  ],
  "entry": "overlay.html",
  "cursor": "replace",
  "thumbnail": "thumbnail.svg",
  "accent": "#8f6bff",
  "hints": [
    "Circle to feed it",
    "Complete the orbits to collapse",
    "Hotkey toggles it on and off"
  ],
  "settings": [
    {
      "key": "size",
      "label": "Size",
      "type": "range",
      "group": "Motion",
      "min": 0.6,
      "max": 1.8,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "loops",
      "label": "Orbits to collapse",
      "type": "range",
      "group": "Trigger",
      "min": 0.75,
      "max": 3,
      "step": 0.05,
      "default": 1.5,
      "hint": "How many full circles feed it"
    },
    {
      "key": "volume",
      "label": "Volume",
      "type": "range",
      "group": "Trigger",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "hot",
      "label": "Disk color",
      "type": "color",
      "group": "Look",
      "default": "#ffb36b"
    },
    {
      "key": "halo",
      "label": "Halo color",
      "type": "color",
      "group": "Look",
      "default": "#8f6bff"
    },
    {
      "key": "particles",
      "label": "Trigger effects",
      "type": "toggle",
      "group": "Look",
      "default": true,
      "hint": "Shockwaves and particles when it fires"
    }
  ]
}
