{
  "id": "whip",
  "name": "The Whip",
  "version": "2.0.0",
  "author": "Cursora",
  "description": "A physics-driven bullwhip that follows your cursor. Flick it hard enough and it cracks with a sharp snap.",
  "category": "Classic",
  "tags": [
    "classic",
    "physics",
    "sound"
  ],
  "entry": "overlay.html",
  "cursor": "replace",
  "thumbnail": "thumbnail.svg",
  "accent": "#ff7a1a",
  "settings": [
    {
      "key": "segments",
      "label": "Length (links)",
      "type": "range",
      "group": "Physics",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 28
    },
    {
      "key": "segmentLength",
      "label": "Link length",
      "type": "range",
      "group": "Physics",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 25,
      "unit": "px"
    },
    {
      "key": "gravity",
      "label": "Gravity",
      "type": "range",
      "group": "Physics",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "default": 1.2
    },
    {
      "key": "damping",
      "label": "Air drag",
      "type": "range",
      "group": "Physics",
      "min": 0.85,
      "max": 0.995,
      "step": 0.005,
      "default": 0.96,
      "hint": "Higher keeps momentum longer"
    },
    {
      "key": "tipMaxBendDeg",
      "label": "Tip flexibility",
      "type": "range",
      "group": "Physics",
      "min": 30,
      "max": 170,
      "step": 1,
      "default": 130,
      "unit": "°"
    },
    {
      "key": "wallBounce",
      "label": "Edge bounce",
      "type": "range",
      "group": "Physics",
      "min": 0,
      "max": 1,
      "step": 0.02,
      "default": 0.42
    },
    {
      "key": "crackSpeed",
      "label": "Crack threshold",
      "type": "range",
      "group": "Crack",
      "min": 120,
      "max": 700,
      "step": 10,
      "default": 340,
      "hint": "Lower cracks more easily"
    },
    {
      "key": "volume",
      "label": "Crack volume",
      "type": "range",
      "group": "Crack",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "unit": "%"
    },
    {
      "key": "color",
      "label": "Whip color",
      "type": "color",
      "group": "Look",
      "default": "#111111"
    },
    {
      "key": "outlineColor",
      "label": "Outline color",
      "type": "color",
      "group": "Look",
      "default": "#ffffff"
    },
    {
      "key": "lineWidthHandle",
      "label": "Handle thickness",
      "type": "range",
      "group": "Look",
      "min": 2,
      "max": 16,
      "step": 0.5,
      "default": 7,
      "unit": "px"
    },
    {
      "key": "lineWidthTip",
      "label": "Tip thickness",
      "type": "range",
      "group": "Look",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "default": 5,
      "unit": "px"
    },
    {
      "key": "outlineWidth",
      "label": "Outline width",
      "type": "range",
      "group": "Look",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "default": 3,
      "unit": "px"
    }
  ]
}
